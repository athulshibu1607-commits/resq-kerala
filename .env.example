# ==============================================================================
# RESQ KERALA — Environment Configuration
# ==============================================================================

# Supabase Project URL and Anon Key (from your Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Supabase Service Role Key (SERVER-ONLY — Never expose to browser or commit)
# Required for administrative operations like server-side role assignment
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Application Base URL (used for Auth callback redirects and PWA Install QR code)
# In development: http://localhost:3000
# In production: https://resq-kerala.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Indian SMS / Emergency Webhook Integration
# TELECOM_SMS_GATEWAY_URL=
# TELECOM_SMS_API_KEY=
